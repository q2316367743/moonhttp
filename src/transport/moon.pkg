// transport 是本模块唯一依赖 async 运行时的包：
// 配置合并、URL 拼接、头拍平等纯逻辑都留在其它包里，可以离线同步测试。
// core/error 用于把底层错误渲染成可读消息，core/debug 用于 Debug 实现，
// core/encoding/utf8 用于按分隔符读流时的文本解码，
// core/buffer 用于读全量时把分块攒起来（中途失败也要能交出已读到的部分）。
import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/core/buffer",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "q2316368843/moonhttp/config",
  "q2316368843/moonhttp/headers",
}

// socket 只给测试用：起一个本机 server 验证真实连接的流式读取。
import {
  "moonbitlang/async/socket",
} for "test"
