// 根包是门面与编排层：
// - 对外公开 Client / Response / StreamResponse / SseStream / HttpError，
//   并用 pub using 再导出子包的类型；
// - 编排「合并配置 → 拼 URL → 拍平头 → 传输 → 解码 → 校验」这条管线，
//   其中纯逻辑那半在 util 包里，这里只留与门面类型接壤的部分。
// 管线本身只通过 transport 包的 trait 交互，因此可以用 Mock 传输层做
// 同步/异步测试；import httpconn 只为提供缺省传输实现（自研 HTTP/1.1 栈，
// 见 docs/17 / 18）——它实现的是同一个 trait。
//
// core/json 是生产依赖（不是只为测试）：`Response::json` 是门面上的解析入口，
// 它抛 `@json.ParseError`，不参与本项目的错误体系（见 facade.mbt）。
import {
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "q2316367743/moonhttp/abort",
  "q2316367743/moonhttp/config",
  "q2316367743/moonhttp/cookie",
  "q2316367743/moonhttp/headers",
  "q2316367743/moonhttp/httpconn",
  "q2316367743/moonhttp/sse",
  "q2316367743/moonhttp/transport",
  "q2316367743/moonhttp/util",
}

// 白盒测试被编进本包，看见的是**生产** import 那份清单，所以要单独声明
// 它自己的依赖（与黑盒测试写 `for "test"` 同理）。这里只用它造 UTF-8 字节。
import {
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

// 黑盒测试要 import 本模块的子包（Mock 传输层等），
// async 用于运行 async test。
//
// `async/http` 与 `async/socket` 只给测试用：SSE 的验收用例要起一个本机
// server，用真实连接证明「事件能在服务端停顿期间就到达」；代理的验收用例
// 要起一个本机 CONNECT 代理。**生产代码不碰 async/http**——旧栈删除后
// （docs/17 / 18），对底层 HTTP 库的依赖为 0，网络交互只集中在
// src/httpconn/（自研栈）；测试里的 `@http.Server` 只是起本机服务器的夹具。
// `util` 在黑盒测试里直接 import：代理凭据落在哪个请求上属于拼装层的契约，
// 除了端到端用例，还要有一条不走网络的断言。
// core/json 给「响应体后处理」那几条用例用（`@json.Replacer::exclude`）；
// 其余用例断言的是门面的返回值，不需要直接调 `@json`。
// `async/gzip` 与 `async/io` 也只给测试用：gzip 的用例要造**真的**压缩字节
// （用底层自带的编码器），而不是手抄一份字节串。
import {
  "moonbitlang/async",
  "moonbitlang/async/gzip",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "q2316367743/moonhttp/transport",
  "q2316367743/moonhttp/util",
} for "test"
