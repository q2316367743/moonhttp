// 根包是门面与编排层：
// - 对外公开 Client / Response / HttpError，并用 pub using 再导出子包的类型；
// - 编排「合并配置 → 拼 URL → 拍平头 → 传输 → 解析 → 校验」这条管线。
// 这里不直接依赖 async 传输实现，只通过 transport 包的 trait 交互，
// 因此管线本身可以用 Mock 传输层做同步/异步测试。
import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "q2316368843/moonhttp/config",
  "q2316368843/moonhttp/headers",
  "q2316368843/moonhttp/merge",
  "q2316368843/moonhttp/transport",
  "q2316368843/moonhttp/url",
}

// 黑盒测试要 import 本模块的子包（Mock 传输层等），
// async 用于运行 async test。
import {
  "moonbitlang/async",
  "moonbitlang/core/encoding/utf8",
  "q2316368843/moonhttp/transport",
} for "test"
